APP_NAME=Florece
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Set to false to hide the Laravel Debugbar bar at the bottom (dev only).
DEBUGBAR_ENABLED=false
APP_URL=http://localhost

# Landing: enlaces de contacto y redes (placeholders editables)
MARKETING_WHATSAPP_URL=https://wa.me/50500000000
MARKETING_INSTAGRAM_URL=https://www.instagram.com/florece.app
MARKETING_FACEBOOK_URL=https://www.facebook.com/floreceapp

# Next (apps/web) — prefer NEXT_PUBLIC_* in apps/web/.env.local
# NEXT_PUBLIC_MARKETING_WHATSAPP_URL=https://wa.me/50500000000

# Platform admin (seed): ops / owner@florece.app / florece-owner-2026 → /admin
# Salon demo: demo / admin@demo.florece.app / demo1234 → /s/demo/admin
# Flujo NI: registrar pago manual en /admin → activa subscriptionEndsAt

# Dominio para subdominios de tenant (producción: florece.app | local: localhost)
TENANT_DOMAIN=

# En local, usar ?tenant=slug cuando no hay subdominios (php artisan serve)
TENANT_LOCAL_QUERY_FALLBACK=true

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=salon_saas
DB_USERNAME=shearly
DB_PASSWORD=

# prefer (local) | require (Azure PostgreSQL y la mayoría de nubes)
DB_SSLMODE=prefer

# Stripe (Laravel Cashier)
STRIPE_KEY=pk_test_xxx
STRIPE_SECRET=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
CASHIER_CURRENCY=usd
CASHIER_CURRENCY_LOCALE=en
# IDs de Stripe Price por región (opcional, para seeders)
STRIPE_PRICE_BASICO_NI=price_xxx
STRIPE_PRICE_BASICO_US=price_xxx
STRIPE_PRICE_PRO_NI=price_xxx
STRIPE_PRICE_PRO_US=price_xxx

# Días de gracia para past_due antes de bloquear (null = bloquear inmediato)
BILLING_PAST_DUE_GRACE_DAYS=3

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
