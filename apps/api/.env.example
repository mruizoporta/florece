NODE_ENV=development
PORT=3001
# Local: postgresql://USER@127.0.0.1:5432/salon_saas?sslmode=prefer
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/salon_saas?sslmode=prefer
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGIN=http://localhost:3000
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/billing/success
STRIPE_CANCEL_URL=http://localhost:3000/billing/cancel
APP_URL=http://localhost:3000
# Public URL of this API (web Socket.IO uses NEXT_PUBLIC_WS_URL pointing here)
API_URL=http://localhost:3001

# Correo (olvidé mi contraseña). Sin SMTP_HOST, en dev el enlace sale en la consola del API.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Florece <noreply@floreceapp.com>

# Imágenes locales (prod: /var/lib/florece/storage)
STORAGE_ROOT=./storage

# SupportFlow (mismo Droplet en prod: http://127.0.0.1:4110/api)
SUPPORTFLOW_URL=http://localhost:4100/api
SUPPORTFLOW_API_KEY=sf_live_5a100000000000000000000000000001

# Platform demo (after seed):
# Login slug ops · mruiz@galilinnovations.com · contraseña = PLATFORM_OWNER_PASSWORD → /admin
PLATFORM_OWNER_PASSWORD=
# Salon demo: demo · admin@demo.florece.app · demo1234 → /s/demo/admin

# Clave inicial del salón de prueba de RD (seed-do-trial)
DO_TRIAL_PASSWORD=
