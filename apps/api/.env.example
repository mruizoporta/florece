NODE_ENV=development
PORT=3001
# Local: postgresql://USER@127.0.0.1:5432/salon_saas?sslmode=prefer
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/salon_saas?sslmode=prefer
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGIN=http://localhost:3000
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/billing/success
STRIPE_CANCEL_URL=http://localhost:3000/billing/cancel
APP_URL=http://localhost:3000
# Public URL of this API (web Socket.IO uses NEXT_PUBLIC_WS_URL pointing here)
API_URL=http://localhost:3001

# Platform demo (after seed):
# Login slug ops · owner@florece.app · florece-owner-2026 → /admin
# Salon demo: demo · admin@demo.florece.app · demo1234 → /s/demo/admin
