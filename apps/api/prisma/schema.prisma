generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                   BigInt    @id @default(autoincrement())
  name                 String
  billingRegion        String?   @map("billing_region") @db.VarChar(2)
  billingEmail         String?   @map("billing_email")
  planId               BigInt?   @map("plan_id")
  scheduledPlanId      BigInt?   @map("scheduled_plan_id")
  subscriptionStatus   String    @default("trial") @map("subscription_status") @db.VarChar(20)
  subscriptionEndsAt   DateTime? @map("subscription_ends_at")
  trialEndsAt          DateTime? @map("trial_ends_at")
  pastDueSince         DateTime? @map("past_due_since")
  adminNote            String?   @map("admin_note") @db.Text
  featureOverrides     Json?     @map("feature_overrides")
  stripeId             String?   @map("stripe_id")
  pmType               String?   @map("pm_type")
  pmLastFour           String?   @map("pm_last_four")
  createdAt            DateTime? @map("created_at")
  updatedAt            DateTime? @map("updated_at")

  plan          Plan?                 @relation("OrganizationPlan", fields: [planId], references: [id])
  scheduledPlan Plan?                 @relation("OrganizationScheduledPlan", fields: [scheduledPlanId], references: [id])
  tenants       Tenant[]
  members       OrganizationMember[]
  saasPayments  SaasPayment[]

  @@map("organizations")
}

model OrganizationMember {
  id             BigInt   @id @default(autoincrement())
  organizationId BigInt   @map("organization_id")
  userId         BigInt   @map("user_id")
  orgRole        String   @default("MEMBER") @map("org_role") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model BranchMembership {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  tenantId  BigInt   @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("branch_memberships")
}

model Tenant {
  id             BigInt    @id @default(autoincrement())
  organizationId BigInt    @map("organization_id")
  name           String
  slug           String    @unique
  isDemo         Boolean   @default(false) @map("is_demo")
  locale         String    @default("es") @db.VarChar(10)
  createdAt      DateTime? @map("created_at")
  updatedAt      DateTime? @map("updated_at")

  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users            User[]
  branchMemberships BranchMembership[]
  employees        Employee[]
  customers        Customer[]
  appointments     Appointment[]
  categories       Category[]
  items            Item[]
  orders           Order[]
  orderPayments    OrderPayment[]
  sections         Section[]
  settings         Setting[]
  statuses         Status[]
  types            Type[]
  socials          Social[]
  subscriptions    Subscription[]
  refreshTokens    RefreshToken[]
  sponsors         Sponsor[]
  instagramFeeds   InstagramFeed[]
  expenseCategories ExpenseCategory[]
  expenses         Expense[]
  payrollPayments  PayrollPayment[]
  customerRecords  CustomerRecord[]
  vouchers         Voucher[]
  promotions       Promotion[]
  feedback         Feedback[]
  waitlist         WaitlistEntry[]
  pushTokens       PushToken[]
  cashSessions     CashSession[]
  inventoryMovements InventoryMovement[]
  serviceConsumables ServiceConsumable[]

  @@index([organizationId])
  @@map("tenants")
}

model Plan {
  id              BigInt    @id @default(autoincrement())
  name            String
  slug            String    @unique
  stripePriceIdNi String?   @map("stripe_price_id_ni")
  stripePriceIdUs String?   @map("stripe_price_id_us")
  priceUsMonthly  Decimal?  @map("price_us_monthly") @db.Decimal(10, 2)
  priceNiMonthly  Decimal?  @map("price_ni_monthly") @db.Decimal(10, 2)
  currencyUs      String    @default("USD") @map("currency_us") @db.VarChar(3)
  currencyNi      String    @default("NIO") @map("currency_ni") @db.VarChar(3)
  interval        String    @default("month")
  maxEmployees    Int?      @map("max_employees")
  maxServices     Int?      @map("max_services")
  features        String[]  @default([])
  entitlements    Json      @default("{}")
  active          Boolean   @default(true)
  trialDays       Int       @default(14) @map("trial_days")
  createdAt       DateTime? @map("created_at")
  updatedAt       DateTime? @map("updated_at")

  organizations          Organization[] @relation("OrganizationPlan")
  scheduledOrganizations Organization[] @relation("OrganizationScheduledPlan")
  saasPayments           SaasPayment[]

  @@map("plans")
}

model User {
  id              BigInt    @id @default(autoincrement())
  name            String
  email           String
  emailVerifiedAt DateTime? @map("email_verified_at")
  password        String
  image           String    @default("default.png")
  rememberToken   String?   @map("remember_token")
  tenantId        BigInt    @map("tenant_id")
  employeeId      BigInt?   @unique @map("employee_id")
  platformRole    String?   @map("platform_role") @db.VarChar(32)
  createdAt       DateTime? @map("created_at")
  updatedAt       DateTime? @map("updated_at")

  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee             Employee?            @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  customer             Customer?
  refreshTokens        RefreshToken[]
  passwordResetTokens  PasswordResetToken[]
  modelHasRoles        ModelHasRole[]
  saasPaymentsRecorded SaasPayment[]        @relation("SaasPaymentRecordedBy")
  organizationMembers  OrganizationMember[]
  branchMemberships    BranchMembership[]
  expensesRecorded     Expense[]            @relation("ExpenseRecordedBy")
  cashSessionsOpened   CashSession[]        @relation("CashSessionOpenedBy")
  cashSessionsClosed   CashSession[]        @relation("CashSessionClosedBy")
  pushTokens           PushToken[]
  inventoryMovements   InventoryMovement[]

  @@unique([tenantId, email])
  @@map("users")
}

model SaasPayment {
  id             BigInt   @id @default(autoincrement())
  organizationId BigInt   @map("organization_id")
  amount         Decimal  @db.Decimal(14, 2)
  currency       String   @default("NIO") @db.VarChar(3)
  method         String   @db.VarChar(20)
  reference      String?
  paidAt         DateTime @map("paid_at")
  months         Int      @default(1)
  note           String?  @db.Text
  recordedById   BigInt   @map("recorded_by_id")
  planId         BigInt?  @map("plan_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recordedBy   User         @relation("SaasPaymentRecordedBy", fields: [recordedById], references: [id])
  plan         Plan?        @relation(fields: [planId], references: [id])

  @@index([organizationId])
  @@index([paidAt])
  @@map("saas_payments")
}

model RefreshToken {
  id        BigInt   @id @default(autoincrement())
  tokenHash String   @unique @map("token_hash")
  userId    BigInt   @map("user_id")
  tenantId  BigInt   @map("tenant_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        BigInt    @id @default(autoincrement())
  tokenHash String    @unique @map("token_hash")
  userId    BigInt    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_links")
}

model Role {
  id        BigInt    @id @default(autoincrement())
  name      String
  guardName String    @map("guard_name")
  createdAt DateTime? @map("created_at")
  updatedAt DateTime? @map("updated_at")

  modelHasRoles ModelHasRole[]

  @@unique([name, guardName])
  @@map("roles")
}

model ModelHasRole {
  roleId    BigInt @map("role_id")
  modelType String @map("model_type")
  modelId   BigInt @map("model_id")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user User @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@id([roleId, modelId, modelType])
  @@map("model_has_roles")
}

model Employee {
  id              BigInt   @id @default(autoincrement())
  name            String
  description     String
  image           String
  status          Boolean  @default(true)
  baseSalary      Decimal  @default(0) @map("base_salary") @db.Decimal(10, 2)
  commissionRate  Decimal  @default(0) @map("commission_rate") @db.Decimal(5, 2)
  /// % sobre los productos que vende (0 = no cobra comisión por productos)
  productCommissionRate Decimal @default(0) @map("product_commission_rate") @db.Decimal(5, 2)
  tenantId        BigInt   @map("tenant_id")
  createdAt       DateTime? @map("created_at")
  updatedAt       DateTime? @map("updated_at")

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  schedules    Schedule[]
  appointments Appointment[]
  personalInfo PersonalInformation?
  orders       Order[]
  orderItems   ItemOrder[]
  socials      EmployeeSocial[]
  linkedUser   User?
  payrollPayments PayrollPayment[]
  customerRecords CustomerRecord[]

  @@map("employees")
}

model Schedule {
  id         BigInt  @id @default(autoincrement())
  employeeId BigInt  @map("employee_id")
  weekday    Int
  startTime  DateTime @map("start_time") @db.Time(0)
  endTime    DateTime @map("end_time") @db.Time(0)
  status     Boolean @default(false)
  tenantId   BigInt? @map("tenant_id")
  createdAt  DateTime? @map("created_at")
  updatedAt  DateTime? @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("schedules")
}

model PersonalInformation {
  id         BigInt  @id @default(autoincrement())
  employeeId BigInt  @unique @map("employee_id")
  document   String?
  location   String?
  address    String?
  phone      String?
  createdAt  DateTime? @map("created_at")
  updatedAt  DateTime? @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("personal_information")
}

model Customer {
  id        BigInt  @id @default(autoincrement())
  userId    BigInt  @unique @map("user_id")
  tenantId  BigInt  @map("tenant_id")
  /// Último mensaje de «te extrañamos» (para no escribirle dos veces seguidas)
  lastContactedAt DateTime? @map("last_contacted_at")
  /// Alergias y cuidados a tener en cuenta (ficha técnica)
  allergies String? @db.Text
  createdAt DateTime? @map("created_at")
  updatedAt DateTime? @map("updated_at")

  user         User          @relation(fields: [userId], references: [id])
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  orders       Order[]
  records      CustomerRecord[]

  @@map("customers")
}

/// Ficha técnica: lo que se le hizo a la clienta (fórmula de color, notas, fotos antes/después).
model CustomerRecord {
  id          BigInt    @id @default(autoincrement())
  tenantId    BigInt    @map("tenant_id")
  customerId  BigInt    @map("customer_id")
  employeeId  BigInt?   @map("employee_id")
  serviceName String?   @map("service_name") @db.VarChar(120)
  formula     String?   @db.Text
  notes       String?   @db.Text
  beforePhoto String?   @map("before_photo")
  afterPhoto  String?   @map("after_photo")
  recordedAt  DateTime  @map("recorded_at")
  createdById BigInt?   @map("created_by_id")
  createdAt   DateTime? @map("created_at")
  updatedAt   DateTime? @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([tenantId, customerId, recordedAt])
  @@map("customer_records")
}

model Category {
  id        BigInt  @id @default(autoincrement())
  name      String
  slug      String?
  tenantId  BigInt  @map("tenant_id")
  createdAt DateTime? @map("created_at")
  updatedAt DateTime? @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  Item[]

  @@unique([tenantId, name])
  @@map("categories")
}

model Item {
  id          BigInt   @id @default(autoincrement())
  categoryId  BigInt   @map("category_id")
  name        String
  slug        String
  description String
  price       Decimal  @db.Decimal(10, 2)
  image       String?
  status      Boolean  @default(true)
  tenantId    BigInt   @map("tenant_id")
  createdAt   DateTime? @map("created_at")
  updatedAt   DateTime? @map("updated_at")

  category Category  @relation(fields: [categoryId], references: [id])
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service  Service?
  product  Product?
  orderLines ItemOrder[]

  @@unique([tenantId, name])
  @@unique([tenantId, slug])
  @@map("items")
}

model Service {
  id           BigInt @id @default(autoincrement())
  itemId       BigInt @unique @map("item_id")
  durationTime Int    @default(30) @map("duration_time")
  /// % de comisión propio del servicio; null = el de cada profesional
  commissionRate Decimal? @map("commission_rate") @db.Decimal(5, 2)
  createdAt    DateTime? @map("created_at")
  updatedAt    DateTime? @map("updated_at")

  item                 Item                  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  appointmentServices  AppointmentService[]
  consumables          ServiceConsumable[]

  @@map("services")
}

model Product {
  id        BigInt  @id @default(autoincrement())
  itemId    BigInt  @unique @map("item_id")
  stock     Int     @default(0)
  minStock  Int     @default(0) @map("min_stock")
  /// retail | internal | both
  usage     String  @default("retail") @db.VarChar(20)
  /// unit | g | ml — stock quantities are integers in this unit
  unit      String  @default("unit") @db.VarChar(10)
  /// Código de barras para el lector del punto de venta (opcional, único por salón en la API)
  barcode   String? @db.VarChar(64)
  /// Costo unitario promedio (se recalcula con cada ingreso que trae costo)
  cost      Decimal @default(0) @db.Decimal(12, 2)
  createdAt DateTime? @map("created_at")
  updatedAt DateTime? @map("updated_at")

  item         Item                @relation(fields: [itemId], references: [id], onDelete: Cascade)
  images       Image[]
  movements    InventoryMovement[]
  consumables  ServiceConsumable[]

  @@index([usage])
  @@index([barcode])
  @@map("products")
}

/// Products consumed when a service is sold (Pro+). Quantity uses the same unit as product stock.
model ServiceConsumable {
  id        BigInt    @id @default(autoincrement())
  tenantId  BigInt    @map("tenant_id")
  serviceId BigInt    @map("service_id")
  productId BigInt    @map("product_id")
  quantity  Int       @default(1)
  createdAt DateTime? @map("created_at")
  updatedAt DateTime? @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([serviceId, productId])
  @@index([tenantId])
  @@map("service_consumables")
}

model InventoryMovement {
  id         BigInt    @id @default(autoincrement())
  tenantId   BigInt    @map("tenant_id")
  productId  BigInt    @map("product_id")
  orderId    BigInt?   @map("order_id")
  userId     BigInt?   @map("user_id")
  /// sale | consume | adjustment | receive | restore
  type       String    @db.VarChar(20)
  /// Signed delta: negative = out, positive = in
  quantity   Int
  stockAfter Int       @map("stock_after")
  reason     String?
  /// Ingresos: costo unitario de la compra y proveedor (opcionales)
  unitCost   Decimal?  @map("unit_cost") @db.Decimal(12, 2)
  supplier   String?   @db.VarChar(120)
  createdAt  DateTime? @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, productId, createdAt])
  @@index([orderId])
  @@map("inventory_movements")
}

model Status {
  id          BigInt  @id @default(autoincrement())
  name        String
  description String  @default("")
  color       String? @map("bg_color")
  tenantId    BigInt  @map("tenant_id")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@map("status")
}

model Type {
  id          BigInt  @id @default(autoincrement())
  name        String
  description String  @default("")
  color       String? @map("bg_color")
  tenantId    BigInt  @map("tenant_id")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@map("types")
}

model Appointment {
  id         BigInt    @id @default(autoincrement())
  customerId BigInt    @map("customer_id")
  employeeId BigInt?   @map("employee_id")
  statusId   BigInt    @map("status_id")
  typeId     BigInt    @map("type_id")
  name       String
  phone      String?
  /// Opaque token returned only to the client who booked on the web/app.
  viewToken  String?   @unique @map("view_token") @db.VarChar(64)
  startTime  DateTime? @map("start_time")
  endTime    DateTime? @map("end_time")
  /// Recordatorios automáticos ya enviados (evita repetirlos).
  reminder24hSentAt DateTime? @map("reminder_24h_sent_at")
  reminder2hSentAt  DateTime? @map("reminder_2h_sent_at")
  tenantId   BigInt    @map("tenant_id")
  createdAt  DateTime? @map("created_at")
  updatedAt  DateTime? @map("updated_at")

  customer Customer             @relation(fields: [customerId], references: [id])
  employee Employee?            @relation(fields: [employeeId], references: [id])
  status   Status               @relation(fields: [statusId], references: [id])
  type     Type                 @relation(fields: [typeId], references: [id])
  tenant   Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  services AppointmentService[]
  pushTokens PushToken[]

  @@index([tenantId, startTime])
  @@map("appointments")
}

model AppointmentService {
  id            BigInt @id @default(autoincrement())
  appointmentId BigInt @map("appointment_id")
  serviceId     BigInt @map("service_id")
  createdAt     DateTime? @map("created_at")
  updatedAt     DateTime? @map("updated_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id])

  @@map("appointment_services")
}

model Order {
  id              BigInt    @id @default(autoincrement())
  customerId      BigInt?   @map("customer_id")
  employeeId      BigInt?   @map("employee_id")
  name            String?
  status          String    @default("draft") @db.VarChar(20)
  paymentStatus   Boolean   @default(false) @map("payment_status")
  subtotal        Decimal   @default(0) @db.Decimal(10, 2)
  discountTotal   Decimal   @default(0) @map("discount_total") @db.Decimal(10, 2)
  taxTotal        Decimal   @default(0) @map("tax_total") @db.Decimal(10, 2)
  total           Decimal   @default(0) @db.Decimal(10, 2)
  finalizedAt     DateTime? @map("finalized_at")
  cancelledAt     DateTime? @map("cancelled_at")
  cancelledReason String?   @map("cancelled_reason")
  tenantId        BigInt    @map("tenant_id")
  createdAt       DateTime? @map("created_at")
  updatedAt       DateTime? @map("updated_at")

  customer Customer?      @relation(fields: [customerId], references: [id])
  employee Employee?      @relation(fields: [employeeId], references: [id])
  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items    ItemOrder[]
  payments OrderPayment[]
  inventoryMovements InventoryMovement[]
  discounts OrderDiscount[]

  @@map("orders")
}

model ItemOrder {
  id                      BigInt  @id @default(autoincrement())
  orderId                 BigInt  @map("order_id")
  itemId                  BigInt? @map("item_id")
  productId               BigInt? @map("product_id")
  employeeId              BigInt? @map("employee_id")
  quantity                Int     @default(1)
  price                   Decimal @default(0) @db.Decimal(10, 2)
  productNameSnapshot     String? @map("product_name_snapshot")
  unitPriceSnapshot       Decimal @default(0) @map("unit_price_snapshot") @db.Decimal(10, 2)
  /// Descuento de paquete (sesión cobrada a su valor)
  lineDiscount            Decimal @default(0) @map("line_discount") @db.Decimal(10, 2)
  /// Parte de los descuentos del ticket (a mano, cupón, promoción) que cae en esta línea
  promoDiscount           Decimal @default(0) @map("promo_discount") @db.Decimal(10, 2)
  lineTax                 Decimal @default(0) @map("line_tax") @db.Decimal(10, 2)
  lineTotal               Decimal @default(0) @map("line_total") @db.Decimal(10, 2)
  commissionRateSnapshot  Decimal? @map("commission_rate_snapshot") @db.Decimal(5, 2)
  /// Productos: costo unitario al momento de venderlo (para el margen)
  unitCostSnapshot        Decimal? @map("unit_cost_snapshot") @db.Decimal(12, 2)
  tenantId                BigInt? @map("tenant_id")
  createdAt               DateTime? @map("created_at")
  updatedAt               DateTime? @map("updated_at")

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item     Item?     @relation(fields: [itemId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@map("item_order")
}

model OrderPayment {
  id        BigInt    @id @default(autoincrement())
  tenantId  BigInt    @map("tenant_id")
  orderId   BigInt    @map("order_id")
  method    String    @db.VarChar(20)
  amount    Decimal   @default(0) @db.Decimal(10, 2)
  reference String?
  paidAt    DateTime? @map("paid_at")
  createdAt DateTime? @map("created_at")
  updatedAt DateTime? @map("updated_at")

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("order_payments")
}

model Section {
  id                    BigInt  @id @default(autoincrement())
  aboutUsShowSection    Boolean @default(true) @map("about_us_show_section")
  aboutUsText           String  @default("Sobre nosotros") @map("about_us_text")
  aboutUsIcon           String  @default("icon-line-scissors fs-1") @map("about_us_icon")
  employeesShowSection  Boolean @default(true) @map("employees_show_section")
  employeesText         String  @default("Nuestro equipo") @map("employees_text")
  employeesIcon         String  @default("icon-users fs-1") @map("employees_icon")
  servicesShowSection   Boolean @default(true) @map("services_show_section")
  servicesText          String  @default("Nuestros servicios") @map("services_text")
  servicesIcon          String  @default("icon-sticky-note1 fs-1") @map("services_icon")
  productsShowSection   Boolean @default(true) @map("products_show_section")
  productsText          String  @default("Productos") @map("products_text")
  productsIcon          String  @default("icon-tags fs-1") @map("products_icon")
  instagramShowSection  Boolean @default(true) @map("instagram_show_section")
  instagramText         String  @default("SEGUINOS EN INSTAGRAM") @map("instagram_text")
  instagramIcon         String  @default("icon-instagram") @map("instagram_icon")
  whatsappShowSection   Boolean @default(true) @map("whatsapp_show_section")
  whatsappTitle1        String  @default("¿TIENES ALGUNA DUDA?") @map("whatsapp_title_1")
  whatsappTitle2        String  @default("No dudes en consultar!") @map("whatsapp_title_2")
  whatsappTitle3        String  @default("Al recibir tu mensaje responderemos a la brevedad.") @map("whatsapp_title_3")
  whatsappIcon          String  @default("icon-whatsapp") @map("whatsapp_icon")
  btnWhatsappButtonText String  @default("Abrir chat") @map("btn_whatsapp_button_text")
  tenantId              BigInt  @map("tenant_id")
  createdAt             DateTime? @map("created_at")
  updatedAt             DateTime? @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("sections")
}

model Setting {
  id                         BigInt  @id @default(autoincrement())
  activeAppointment          Boolean @default(true) @map("active_appointment")
  appointmentReminders       Boolean @default(true) @map("appointment_reminders")
  barcodeScanner             Boolean @default(false) @map("barcode_scanner")
  /// Pedir opinión por correo después de cada cita concluida
  feedbackRequests           Boolean @default(true) @map("feedback_requests")
  /// Link para dejar reseña en Google (se ofrece a quien califica 4 o 5)
  googleReviewUrl            String? @map("google_review_url")
  /// Descuento a mano al cobrar: off | admin (solo Admin) | cashier (Admin y Cajero)
  manualDiscounts            String  @default("admin") @map("manual_discounts") @db.VarChar(10)
  /// Tope en % del descuento a mano para quien no es Admin
  manualDiscountMaxPct       Int     @default(20) @map("manual_discount_max_pct")
  /// Si un cupón y una promoción automática se suman (si no, gana la mayor)
  stackPromotions            Boolean @default(false) @map("stack_promotions")
  appointmentType            String  @default("blacklist") @map("appointment_type")
  companyName                String? @map("company_name")
  mailContact                String? @map("mail_contact")
  location                   String?
  address                    String?
  phone                      String?
  currencySymbol             String  @default("$") @map("currency_symbol")
  whatsapp                   String?
  instagramHref              String? @map("instagram_href")
  embeddedContentMap         String? @map("embedded_content_map")
  logo                       String  @default("your-logo.png")
  banner                     String  @default("your-banner.jpg")
  aboutUs                    String? @map("about_us")
  schedules                  String?
  imageLeft                  String  @default("image_left.jpg") @map("image_left")
  imageRight                 String  @default("image_right.jpg") @map("image_right")
  imageParallax              String  @default("image_parallax.jpg") @map("image_parallax")
  buttonsBackgroundColor     String  @default("ff8585") @map("buttons_background_color")
  buttonsTextColor           String  @default("ffffff") @map("buttons_text_color")
  iconsColor                 String  @default("ff8585") @map("icons_color")
  titlesColor                String  @default("ff8585") @map("titles_color")
  footerBackgroundColor      String  @default("283747") @map("footer_background_color")
  footerTextColor            String  @default("ffffff") @map("footer_text_color")
  btnWhatsappBackgroundColor String  @default("128c7e") @map("btn_whatsapp_background_color")
  btnWhatsappTextColor       String  @default("ffffff") @map("btn_whatsapp_text_color")
  tenantId                   BigInt  @map("tenant_id")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("settings")
}

model Sponsor {
  id        BigInt    @id @default(autoincrement())
  name      String
  image     String
  tenantId  BigInt    @map("tenant_id")
  createdAt DateTime? @map("created_at")
  updatedAt DateTime? @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("sponsors")
}

model InstagramFeed {
  id        BigInt    @id @default(autoincrement())
  content   String
  tenantId  BigInt    @map("tenant_id")
  createdAt DateTime? @map("created_at")
  updatedAt DateTime? @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("instagram_feeds")
}

model Image {
  id        BigInt  @id @default(autoincrement())
  productId BigInt  @map("product_id")
  image     String
  order     Int
  tenantId  BigInt? @map("tenant_id")
  createdAt DateTime? @map("created_at")
  updatedAt DateTime? @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("images")
}

model EmployeeSocial {
  id         BigInt  @id @default(autoincrement())
  employeeId BigInt  @map("employee_id")
  socialId   BigInt  @map("social_id")
  href       String
  createdAt  DateTime? @map("created_at")
  updatedAt  DateTime? @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  social   Social   @relation(fields: [socialId], references: [id], onDelete: Cascade)

  @@map("employee_social")
}

model Social {
  id        BigInt  @id @default(autoincrement())
  name      String?
  icon      String?
  tenantId  BigInt  @map("tenant_id")
  createdAt DateTime? @map("created_at")
  updatedAt DateTime? @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeSocials EmployeeSocial[]

  @@map("socials")
}

model Subscription {
  id                 BigInt    @id @default(autoincrement())
  tenantId           BigInt    @map("tenant_id")
  type               String
  stripeId           String    @unique @map("stripe_id")
  stripeStatus       String    @map("stripe_status")
  stripePrice        String?   @map("stripe_price")
  quantity           Int?
  trialEndsAt        DateTime? @map("trial_ends_at")
  endsAt             DateTime? @map("ends_at")
  createdAt          DateTime? @map("created_at")
  updatedAt          DateTime? @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, stripeStatus])
  @@map("subscriptions")
}

model ExpenseCategory {
  id        BigInt    @id @default(autoincrement())
  tenantId  BigInt    @map("tenant_id")
  name      String
  slug      String
  active    Boolean   @default(true)
  createdAt DateTime? @map("created_at")
  updatedAt DateTime? @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("expense_categories")
}

model Expense {
  id           BigInt    @id @default(autoincrement())
  tenantId     BigInt    @map("tenant_id")
  categoryId   BigInt    @map("category_id")
  amount       Decimal   @db.Decimal(12, 2)
  currency     String    @default("NIO") @db.VarChar(3)
  method       String    @db.VarChar(20)
  spentAt      DateTime  @map("spent_at")
  note         String?   @db.Text
  receiptUrl   String?   @map("receipt_url")
  recordedById BigInt    @map("recorded_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime? @map("updated_at")

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category   ExpenseCategory @relation(fields: [categoryId], references: [id])
  recordedBy User            @relation("ExpenseRecordedBy", fields: [recordedById], references: [id])

  @@index([tenantId, spentAt])
  @@index([categoryId])
  @@map("expenses")
}

model CashSession {
  id            BigInt    @id @default(autoincrement())
  tenantId      BigInt    @map("tenant_id")
  status        String    @default("open") @db.VarChar(20)
  openedAt      DateTime  @map("opened_at")
  closedAt      DateTime? @map("closed_at")
  openedById    BigInt    @map("opened_by_id")
  closedById    BigInt?   @map("closed_by_id")
  openingFloat  Decimal   @default(0) @map("opening_float") @db.Decimal(12, 2)
  expectedCash  Decimal?  @map("expected_cash") @db.Decimal(12, 2)
  countedCash   Decimal?  @map("counted_cash") @db.Decimal(12, 2)
  difference    Decimal?  @db.Decimal(12, 2)
  snapshot      Json?
  note          String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime? @map("updated_at")

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  openedBy User   @relation("CashSessionOpenedBy", fields: [openedById], references: [id])
  closedBy User?  @relation("CashSessionClosedBy", fields: [closedById], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, openedAt])
  @@map("cash_sessions")
}

/// Pagos de planilla y adelantos. Cada uno genera un gasto «Sueldos» en Utilidad.
model PayrollPayment {
  id           BigInt    @id @default(autoincrement())
  tenantId     BigInt    @map("tenant_id")
  employeeId   BigInt    @map("employee_id")
  /// payment | advance
  kind         String    @db.VarChar(10)
  /// Período liquidado en días del salón (YYYY-MM-DD); null en adelantos
  periodFrom   String?   @map("period_from") @db.VarChar(10)
  periodTo     String?   @map("period_to") @db.VarChar(10)
  base         Decimal   @default(0) @db.Decimal(12, 2)
  commission   Decimal   @default(0) @db.Decimal(12, 2)
  bonus        Decimal   @default(0) @db.Decimal(12, 2)
  deduction    Decimal   @default(0) @db.Decimal(12, 2)
  /// Adelantos descontados en este pago
  advances     Decimal   @default(0) @db.Decimal(12, 2)
  /// Lo que se entregó
  amount       Decimal   @db.Decimal(12, 2)
  method       String    @db.VarChar(20)
  note         String?   @db.Text
  paidAt       DateTime  @default(now()) @map("paid_at")
  recordedById BigInt?   @map("recorded_by_id")
  expenseId    BigInt?   @map("expense_id")
  /// Adelanto: el pago que lo descontó
  appliedToId  BigInt?   @map("applied_to_id")
  cancelledAt  DateTime? @map("cancelled_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId])
  @@map("payroll_payments")
}

/// Bono prepagado: gift card (saldo en plata) o paquete (N sesiones de un servicio).
/// La venta queda en una orden «prepaid» (entra a caja, no es ingreso); el ingreso se reconoce al canjearlo.
model Voucher {
  id            BigInt    @id @default(autoincrement())
  tenantId      BigInt    @map("tenant_id")
  code          String    @db.VarChar(16)
  /// giftcard | package
  kind          String    @db.VarChar(10)
  holderName    String    @map("holder_name") @db.VarChar(120)
  holderPhone   String?   @map("holder_phone") @db.VarChar(40)
  /// Lo que se cobró al venderlo
  price         Decimal   @db.Decimal(12, 2)
  /// Gift card: saldo disponible
  balance       Decimal   @default(0) @db.Decimal(12, 2)
  /// Paquete: servicio (item) y sesiones
  serviceItemId BigInt?   @map("service_item_id")
  serviceName   String?   @map("service_name") @db.VarChar(120)
  sessionsTotal Int       @default(0) @map("sessions_total")
  sessionsUsed  Int       @default(0) @map("sessions_used")
  saleOrderId   BigInt?   @map("sale_order_id")
  expiresAt     DateTime? @map("expires_at")
  cancelledAt   DateTime? @map("cancelled_at")
  createdById   BigInt?   @map("created_by_id")
  createdAt     DateTime? @map("created_at")
  updatedAt     DateTime? @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@map("vouchers")
}

/// Opinión después de la visita. La clienta responde en una página pública con el token.
model Feedback {
  id            BigInt    @id @default(autoincrement())
  tenantId      BigInt    @map("tenant_id")
  token         String    @unique @db.VarChar(48)
  appointmentId BigInt?   @unique @map("appointment_id")
  orderId       BigInt?   @unique @map("order_id")
  customerName  String?   @map("customer_name") @db.VarChar(120)
  employeeId    BigInt?   @map("employee_id")
  employeeName  String?   @map("employee_name") @db.VarChar(120)
  serviceNames  String?   @map("service_names") @db.VarChar(400)
  /// 1 a 5; null = todavía no respondió
  rating        Int?
  comment       String?   @db.Text
  reviewClicked Boolean   @default(false) @map("review_clicked")
  /// email | whatsapp | link
  channel       String    @default("link") @db.VarChar(10)
  answeredAt    DateTime? @map("answered_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, answeredAt])
  @@map("feedback")
}

/// Lista de espera: alguien que quiere un día sin horarios libres. Si se cancela una cita ese día, se le avisa.
model WaitlistEntry {
  id              BigInt    @id @default(autoincrement())
  tenantId        BigInt    @map("tenant_id")
  name            String    @db.VarChar(120)
  phone           String    @db.VarChar(40)
  email           String?   @db.VarChar(160)
  /// Día de salón YYYY-MM-DD
  date            String    @db.VarChar(10)
  /// null = cualquier profesional
  employeeId      BigInt?   @map("employee_id")
  serviceNames    String?   @map("service_names") @db.VarChar(400)
  durationMinutes Int       @default(30) @map("duration_minutes")
  note            String?   @db.VarChar(400)
  /// waiting | booked | dropped
  status          String    @default("waiting") @db.VarChar(12)
  /// web | panel
  source          String    @default("web") @db.VarChar(8)
  /// Última vez que se liberó un horario que le sirve (para resaltarla en el panel)
  slotFreedAt     DateTime? @map("slot_freed_at")
  notifiedAt      DateTime? @map("notified_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, date, status])
  @@map("waitlist")
}

/// Cupón (con código) o promoción automática (se aplica sola si se cumplen las condiciones).
model Promotion {
  id             BigInt    @id @default(autoincrement())
  tenantId       BigInt    @map("tenant_id")
  name           String    @db.VarChar(120)
  /// coupon | auto
  kind           String    @db.VarChar(10)
  code           String?   @db.VarChar(30)
  /// percent | amount
  discountType   String    @map("discount_type") @db.VarChar(10)
  value          Decimal   @db.Decimal(10, 2)
  /// all | services | products | items
  appliesTo      String    @default("all") @map("applies_to") @db.VarChar(10)
  /// appliesTo=items: ids de items (servicios o productos)
  itemIds        Json?     @map("item_ids")
  /// Días 1 (lunes) a 7 (domingo); vacío = todos
  weekdays       Json?
  /// Franja horaria local "HH:MM"; vacío = todo el día
  fromTime       String?   @map("from_time") @db.VarChar(5)
  toTime         String?   @map("to_time") @db.VarChar(5)
  firstVisitOnly Boolean   @default(false) @map("first_visit_only")
  minTotal       Decimal?  @map("min_total") @db.Decimal(10, 2)
  /// Vigencia en fechas del salón "YYYY-MM-DD"
  startsOn       String?   @map("starts_on") @db.VarChar(10)
  endsOn         String?   @map("ends_on") @db.VarChar(10)
  maxUses        Int?      @map("max_uses")
  usesCount      Int       @default(0) @map("uses_count")
  showOnBooking  Boolean   @default(false) @map("show_on_booking")
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime? @map("updated_at")

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  discounts OrderDiscount[]

  @@unique([tenantId, code])
  @@index([tenantId, kind, active])
  @@map("promotions")
}

/// Descuento aplicado a un ticket. El monto se recalcula con cada cambio del ticket mientras está en borrador.
model OrderDiscount {
  id           BigInt    @id @default(autoincrement())
  tenantId     BigInt    @map("tenant_id")
  orderId      BigInt    @map("order_id")
  promotionId  BigInt?   @map("promotion_id")
  /// manual | coupon | auto
  source       String    @db.VarChar(10)
  label        String    @db.VarChar(120)
  discountType String    @map("discount_type") @db.VarChar(10)
  value        Decimal   @db.Decimal(10, 2)
  amount       Decimal   @default(0) @db.Decimal(10, 2)
  /// Por qué no descuenta ahora (no cumple condiciones, no se combina…)
  note         String?   @db.VarChar(160)
  reason       String?   @db.VarChar(200)
  /// Promoción automática que la caja sacó a mano
  dismissed    Boolean   @default(false)
  createdById  BigInt?   @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  promotion Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([tenantId, createdAt])
  @@map("order_discounts")
}

/// Token de notificaciones push (Expo). De una cita (la clienta no tiene cuenta) o de un usuario del salón.
model PushToken {
  id            BigInt   @id @default(autoincrement())
  token         String   @db.VarChar(255)
  tenantId      BigInt   @map("tenant_id")
  userId        BigInt?  @map("user_id")
  appointmentId BigInt?  @map("appointment_id")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([appointmentId])
  @@map("push_tokens")
}
